def stand_in_searxng():
    """A tiny server answering SearXNG's JSON search with WEB, and empty autocompletes."""
    import http.server
    import json
    import threading

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            body = json.dumps(WEB if self.path.startswith("/search") else []).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


# A stand-in Kura for the shots (without --kura): a few invented notes from the sample vault's paper-lantern workshop
# and Kyoto trip, answering the calls Shiori makes (api/search, api/recent, api/vaults, api/note).
from sampledata import NOTES  # noqa: E402  (tools/sampledata.py)


def stand_in_kura():
    """A tiny server answering Kura's API with NOTES, at its own address (the notes' /n/ pages)."""
    import html
    import http.server
    import json
    import re
    import threading
    import urllib.parse

    now = int(time.time())

    def note(path, tags, days, summary, items, base, snippet=None):
        return {"url": base + "n/" + urllib.parse.quote(path), "title": path.rsplit("/", 1)[-1], "path": path + ".md",
                "vault": "", "snippet": snippet or html.escape(summary), "summary": summary, "tags": tags,
                "created": now - days * 86400 - 7200, "changed": now - days * 86400}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            url = urllib.parse.urlsplit(self.path)
            args = dict(urllib.parse.parse_qsl(url.query))
            base = "http://%s:%d/" % self.server.server_address[:2]
            status, reply = 200, None
            if url.path == "/api/vaults":
                reply = {"vaults": [{"name": "sample", "title": "Sample", "default": True, "private": False,
                                     "obsidian": "Sample"}]}
            elif url.path in ("/api/search", "/api/recent"):
                words = [w.strip('"*').lower() for w in args.get("q", "").split() if w.strip('"*')]
                found = []
                for path, tags, days, summary, items in NOTES:
                    hay = " ".join([path, summary, " ".join(tags)]).lower()
                    if all(re.search(r"\b" + re.escape(w), hay) for w in words):
                        snippet = html.escape(summary)
                        for w in words:
                            snippet = re.sub(r"(?i)\b(%s\w*)" % re.escape(html.escape(w)), r"<mark>\1</mark>", snippet)
                        found.append(note(path, tags, days, summary, items, base, snippet))
                reply = {"total": len(found), "results": found}
            elif url.path == "/api/note":
                want = args.get("path", "")
                for path, tags, days, summary, items in NOTES:
                    if want in (path, path + ".md"):
                        body = "".join("<li>%s</li>" % html.escape(i) for i in items)
                        reply = {"title": path.rsplit("/", 1)[-1], "path": path + ".md",
                                 "html": "<p>%s</p><ul>%s</ul><p>%s</p>" % (
                                     html.escape(summary), body, " ".join("#" + t for t in tags))}
                if reply is None:
                    status, reply = 404, {"error": "not_found"}
            else:
                status, reply = 404, {"error": "not_found"}
            body = json.dumps(reply).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def stand_in_helper():
    """Hister's sign-in helper (/machiya/), as a sample install would answer it: nobody signed in (401), so Settings
    says how the settings would follow you instead of that sign-in is out of reach."""
    import http.server
    import threading

    class Handler(http.server.BaseHTTPRequestHandler):
        def reply(self):
            body = b'{"error": "signed_out"}'
            self.send_response(401)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        do_GET = do_PUT = do_POST = reply

        def log_message(self, *args):
            pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def squeeze(path):
    if os.path.getsize(path) <= LIMIT:
        return
    from PIL import Image
    im = Image.open(path).convert("RGB").quantize(colors=128, method=Image.Quantize.MEDIANCUT, dither=Image.Dither.NONE)
    im.save(path, optimize=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--kura", default="", help="a Kura serving Machiya's sample vault, for the notes")
    ap.add_argument("--hister", default="", help="a throwaway Hister already running on this machine, instead of a container")
    ap.add_argument("--keep", action="store_true", help="leave Hister and the pages up afterwards, and say where")
    ap.add_argument("out", nargs="?", default=os.path.join(ROOT, "docs", "screenshots"))
    a = ap.parse_args()
    engine = shutil.which("podman") or shutil.which("docker")
    if not engine and not a.hister:
        sys.exit("screenshots: needs podman or docker for Hister (or --hister)")

    work = tempfile.mkdtemp(prefix="shiori-shots-", dir=os.environ.get("SHOTS_TMP", "/var/tmp"))
    hister_port, site_port, app_port = free_port(), free_port(), free_port()
    name = "shiori-shots-%d" % hister_port
    servers = []
    env = {k: v for k, v in os.environ.items() if not k.startswith(("SHIORI_", "HISTER_", "KURA_", "SEARXNG_"))}
    env["TZ"] = "UTC"
    try:
        if a.hister:
            hister = a.hister.rstrip("/") + "/"
        else:
            subprocess.run([engine, "run", "-d", "--name", name, "-p", "127.0.0.1:%d:4433" % hister_port,
                            "-e", "HISTER__SERVER__ADDRESS=0.0.0.0:4433",
                            "-e", "HISTER__SERVER__BASE_URL=http://localhost:%d" % hister_port, HISTER_IMAGE],
                           check=True, capture_output=True)
            hister = "http://127.0.0.1:%d/" % hister_port
        subprocess.run([os.path.join(ROOT, "tools", "quickstart", "seed-hister.py"), hister], check=True, env=env)
        site, app = os.path.join(work, "site"), os.path.join(work, "app")
        kura = a.kura or "http://127.0.0.1:%d/" % stand_in_kura().server_address[1]
        build_env = dict(env, SHIORI_NIWA_URL=kura)
        subprocess.run([os.path.join(ROOT, "scripts", "build-web.sh"), site, "http://localhost:%d/" % site_port],
                       check=True, cwd=ROOT, env=build_env, capture_output=True)
        subprocess.run([os.path.join(ROOT, "scripts", "build-pwa.sh"), app], check=True, cwd=ROOT, env=build_env,
                       capture_output=True)
        searx = stand_in_searxng()
        helper = "http://127.0.0.1:%d/" % stand_in_helper().server_address[1]
        for path, port in ((site, site_port), (app, app_port)):
            serve_env = dict(env, HISTER_URL=hister, PORT=str(port), KURA_URL=kura, MACHIYA_URL=helper,
                             SEARXNG_URL="http://127.0.0.1:%d/" % searx.server_address[1])
            servers.append(subprocess.Popen([sys.executable, os.path.join(ROOT, "web", "dev-server.py"), path],
                                            cwd=ROOT, env=serve_env, stdout=subprocess.DEVNULL,
                                            stderr=subprocess.DEVNULL, start_new_session=True))
        wait("http://127.0.0.1:%d/" % site_port)
        wait("http://127.0.0.1:%d/" % app_port)
        time.sleep(2)  # Hister indexes the pages a moment after they're added

        os.makedirs(a.out, exist_ok=True)
        site_url, app_url = "http://localhost:%d" % site_port, "http://localhost:%d" % app_port
        with sync_playwright() as p:
            browser = p.chromium.launch()

            def shot(what, url, viewport, scheme, ready, steps=()):
                context = browser.new_context(viewport=viewport, color_scheme=scheme, device_scale_factor=1,
                                              timezone_id="UTC", locale="en-US")
                page = context.new_page()
                page.goto(url)
                # Visible only: the search page keeps hidden headings (#hister-title) with the same words.
                page.locator("text=%s >> visible=true" % ready).first.wait_for(timeout=30000)
                for step in steps:
                    step(page)
                page.mouse.move(viewport["width"] - 2, viewport["height"] - 2)  # no hover underline
                page.wait_for_timeout(1200)
                out = os.path.join(a.out, "shiori-%s-%s.png" % (what, scheme))
                page.screenshot(path=out)
                context.close()
                squeeze(out)
                print("%s  %d KB" % (out, os.path.getsize(out) // 1024))

            def open_page(page):
                page.get_by_text("A chōchin collapses flat").first.click()  # the row; its title opens the page itself
                page.frame_locator("iframe").get_by_text("A chōchin collapses flat").first.wait_for(timeout=15000)
                page.evaluate("document.querySelectorAll('#list, main, body').forEach((e) => e.scrollTo(0, 0))")

            def open_note(page):
                page.get_by_text("Everything for the summer lantern festival").first.click()  # the row; its title opens Kura
                page.frame_locator("iframe").get_by_text("Twelve LED inserts").first.wait_for(timeout=15000)
                page.evaluate("document.querySelectorAll('#list, main, body').forEach((e) => e.scrollTo(0, 0))")

            def open_sections(page):
                for heading in ("Your Pages", "Your Notes"):
                    button = page.locator("button.fold-head", has_text=heading)
                    if button.count() and button.first.get_attribute("aria-expanded") == "false":
                        button.first.click()
                page.wait_for_timeout(600)
                page.evaluate("window.scrollTo(0, 0)")

            for scheme in ("light", "dark"):
                shot("library", app_url + "/", DESKTOP, scheme, "Folding a chōchin lantern", (open_page,))
                # All mixes your pages into the web's results (no "Your Pages" section since 0.2.0).
                shot("search", site_url + "/?q=lantern", DESKTOP, scheme, "Folding a chōchin lantern", (open_sections,))
            shot("notes", app_url + "/#/library?s=notes", DESKTOP, "light", "Lantern festival kit", (open_note,))
            shot("settings", app_url + "/#/settings", DESKTOP, "dark", "Appearance")
            shot("library-phone", app_url + "/", PHONE, "light", "Folding a chōchin lantern")
            browser.close()
    finally:
        if a.keep:
            print("kept: Shiori on http://localhost:%d/, the web app on http://localhost:%d/, Hister %s"
                  % (site_port, app_port, name))
            print("the stand-in SearXNG stops with this script; the pages' web results won't answer")
        else:
            for s in servers:
                try:
                    os.killpg(s.pid, signal.SIGTERM)
                except OSError:
                    pass
            if not a.hister:
                subprocess.run([engine, "rm", "-f", name], capture_output=True)
            shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
