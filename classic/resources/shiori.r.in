	{
		{ 60, 210, 80, 280 }, Button { enabled, "Find" };
		{ 60, 120, 80, 190 }, Button { enabled, "Cancel" };
		{ 14, 14, 30, 60 }, StaticText { disabled, "Find:" };
		{ 14, 66, 30, 284 }, EditText { enabled, "" };
