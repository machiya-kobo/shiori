/* Shiori for Classic Macintosh: resources (Rez). */
#include "Processes.r"
#include "Menus.r"
#include "Windows.r"
#include "Dialogs.r"
#include "balloons.r"

resource 'MBAR' (128) {
	{ 128, 129, 130, 131 };
};

/* Item 2 of the Apple menu is a separator: the enable flags' bit 1 is clear. */
resource 'MENU' (128) {
	128, textMenuProc, 0x7FFFFFFD, enabled, apple,
	{
		"About Shiori\311", noIcon, noKey, noMark, plain;
		"-", noIcon, noKey, noMark, plain;
	}
};

resource 'MENU' (129) {
	129, textMenuProc, 0x7FFFFFFF, enabled, "File",
	{
		"Open", noIcon, "O", noMark, plain;
		"Close", noIcon, "W", noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Preferences\311", noIcon, noKey, noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Quit", noIcon, "Q", noMark, plain;
	}
};

resource 'MENU' (130) {
	130, textMenuProc, 0x7FFFFFFF, enabled, "Edit",
	{
		"Undo", noIcon, "Z", noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Cut", noIcon, "X", noMark, plain;
		"Copy", noIcon, "C", noMark, plain;
		"Paste", noIcon, "V", noMark, plain;
		"Clear", noIcon, noKey, noMark, plain;
		"Select All", noIcon, "A", noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Copy Link", noIcon, "L", noMark, plain;
	}
};

resource 'MENU' (131) {
	131, textMenuProc, 0x7FFFFFFF, enabled, "Search",
	{
		"Find\311", noIcon, "F", noMark, plain;
		"Find Again", noIcon, "G", noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"All", noIcon, "1", noMark, plain;
		"Pages", noIcon, "2", noMark, plain;
		"Notes", noIcon, "3", noMark, plain;
		"Code", noIcon, "4", noMark, plain;
		"-", noIcon, noKey, noMark, plain;
		"Show More", noIcon, "M", noMark, plain;
		"Stop", noIcon, noKey, noMark, plain;
	}
};

resource 'ALRT' (128, purgeable) {
	{ 60, 60, 190, 400 }, 128,
	{
		OK, visible, sound1;
		OK, visible, sound1;
		OK, visible, sound1;
		OK, visible, sound1;
	},
	alertPositionMainScreen
};

resource 'DITL' (128, purgeable) {
	{
		{ 98, 260, 118, 330 }, Button { enabled, "OK" };
		{ 10, 20, 90, 330 }, StaticText { disabled,
			"Shiori for Classic Macintosh\r"
			"Version @SHIORI_VERSION@\r\r"
			"Search your pages in Hister and your notes in Kura." };
	}
};

