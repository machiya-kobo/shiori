    { "steps": "apple", "house": "standard", "local": "system" },
    { "steps": "rooms", "house": "large", "local": "large" }
  ],
  "pills": [
    { "local": ["all", "pages", "-web", "notes"], "account": "{\"order\":[\"all\",\"pages\",\"web\",\"notes\"],\"hidden\":[\"web\"]}" },
    { "local": [], "account": "" }
  ],
  "valid": [
    { "key": "theme", "value": "night", "ok": true },
    { "key": "theme", "value": "auto", "ok": false },
    { "key": "palette", "value": "ayu", "ok": true },
    { "key": "text_size", "value": "huge", "ok": false },
    { "key": "pills", "value": "{\"order\":[\"all\",\"bogus\"],\"hidden\":[]}", "ok": false },
    { "key": "shiori.show_infobox", "value": "on", "ok": true },
    { "key": "shiori.show_infobox", "value": "true", "ok": false },
